# Основни настройки за Apache
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/javascript .js
  AddCharset utf-8 .html .css .js .json
</IfModule>

# Компресия - данните за Лабораторията стават около 4 пъти по-малки при сваляне
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# Скриптовете и стиловете да се проверяват за нова версия
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^(README\.md|AGENTS\.md|DEVELOPMENT\.md|CHANGELOG\.md|.*\.zip)$">
  Require all denied
</FilesMatch>

<If "%{REQUEST_URI} =~ m#(^|/)\.#">
  Require all denied
</If>
