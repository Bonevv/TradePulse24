# През HTTP се отварят само обновяването, административният запис, Пулс и публичните разходи.
# Всичко останало е забранено: библиотеките, стари PHP файлове след обновяване
# и случайни копия като config.php.bak или config.php~, които иначе биха се показали като текст.
Require all denied
<FilesMatch "^(cron|save|puls|state)\.php$">
  Require all granted
</FilesMatch>
